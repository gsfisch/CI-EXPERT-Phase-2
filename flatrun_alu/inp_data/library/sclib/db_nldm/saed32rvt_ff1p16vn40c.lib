 /*tc for RSDFFNSRARX2, with original outputs */
 test_cell(){  
 	ff("IQ","IQN") {
 	next_state : "D (NRESTORE !SAVE)";
 	clocked_on : "CLK'";
 	clear : "!RSTB";
 }
 pin (SE) {
 	direction : "input" ;
 	signal_type : "test_scan_enable";
 }
 pin (SI) {
 	direction : "input" ;
 	signal_type : "test_scan_in";
 }
 pin (CLK) {
 	direction : "input" ;
 }
 pin (RSTB) {
 	direction : "input" ;
 }
 pin (SAVE) {
 	direction : "input" ;
 }
 pin (QN) {
 	direction : "output" ;
 	function : "IQN" ;
 	signal_type : "test_scan_out_inverted";
 }
 pin (Q) {
 	direction : "output" ;
 	function : "IQ" ;
 	signal_type : "test_scan_out";
 }
 pin (D) {
 	direction : "input" ;
 }
 pin (NRESTORE) {
 	direction : "input" ;
 }
 } /* end-of-test-cell */
